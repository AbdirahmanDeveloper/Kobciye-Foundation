include ../layout/_head
footer
  .footer-newsletter
    .footer-newsletter-inner
      .footer-newsletter-txt
        h3 Stay in the loop
        p Get updates on our projects, impact stories, and ways to get involved.
      .newsletter-input-box
        form#newsletterForm
          input#newsletterEmail(type="email" placeholder="JoeDoe@email.com" name="email" required)
          button(type="submit") Subscribe →

  .checked-subscriber
    h3 Subscribed Successfully
    i.fa-solid.fa-circle-check
  .footer-top
    .footer-brand
      a.footer-logo(href="/")
        .logo-icon KF
        .logo-brand
          span.logo-brand-main Kobciye
          span.logo-brand-sub Foundation
      p.footer-desc A nonprofit organization dedicated to transforming lives through education, healthcare, and community development across Kenya.
      .social-links
        a(href="https://www.instagram.com/kobciye_foundation?igsh=MWRiZ2Nka2hib2FkYQ%3D%3D&utm_source=qr" target="_blank" rel="noopener")
          i.fa-brands.fa-instagram
        a(href="https://www.facebook.com/share/18G9SXeWUo/?mibextid=wwXIfr" target="_blank" rel="noopener")
          i.fa-brands.fa-facebook
        a(href="https://www.tiktok.com/@kobciye_foundation?_r=1&_t=ZS-954FMMeNA7o" target="_blank" rel="noopener")
          i.fa-brands.fa-tiktok
        a(href="https://wa.me/254722265078" target="_blank" rel="noopener")
          i.fa-brands.fa-whatsapp
        a(href="https://youtube.com/@kobciyefoundation?si=zqO_zdQB8dXHFo5b" target="_blank" rel="noopener")
          i.fa-brands.fa-youtube
      .footer-contact
        p
          i.fa-solid.fa-envelope
          | info@kobciye.org
        p
          i.fa-solid.fa-phone
          | +254 722 265 078

    .footer-col
      h3 Navigate
      ul
        li: a(href="/") Home
        li: a(href="/about") About Us
        li: a(href="/projects") Projects
        li: a(href="/blog") Blog
        li: a(href="/contact") Contact Us

    .footer-col
      h3 Our Projects
      ul
        each project in (typeof footerProjects !== 'undefined' ? footerProjects : [])
          li: span= project.title
        if (typeof footerProjects === 'undefined' || footerProjects.length === 0)
          li: span Clean Water Initiative
          li: span Education for All
          li: span Healthcare Outreach
          li: span Women Empowerment
          li: span Youth Development

    .footer-col.footer-cta-col
      h3 Make a Difference
      p Every contribution helps us reach more communities in need.
      a.footer-cta-btn(href="/payment")
        i.fa-solid.fa-heart
        | Donate Now

  .footer-divider

  .footer-bottom
    p &copy; #{new Date().getFullYear()} Kobciye Foundation. All rights reserved.
    .footer-links
      a(href="/privacy") Privacy Policy
      span |
      a(href="/terms") Terms of Service

script(src="/js/footer.js")
script(src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js")
script.
  AOS.init({ once: true, duration: 700, offset: 80, easing: "ease-in-out" });