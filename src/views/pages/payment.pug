doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Payment Gateway
    link(rel="stylesheet" href="/css/payment.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css")
    link(rel="icon" type="image/x-icon" href="/images/favicon.ico")

  body
    .payment-form
      .form
        //- Status message
        #paymentStatus.payment-status(style="display:none" )
        h2 Make a Donation

        //- Project Selection
        label(for="project-category") Choose Project *
        select#project-category(name="project" required)
          option(value="" disabled selected) Select a project
          option(value="monthly") monthly donation
          option(value="custom") custom donation
          each project in projects
            option(value=project._id)= project.title

        //- DONATION TYPE SELECTION
        label(for="donation-type") Choose Donation Type *
        select#donationType(name="donationType" required)
          option(value="" disabled selected) Select a Donation Type
          option(value="project") Project
          option(value="monthly") monthly donation
          option(value="custom") custom donation

        //- Payment Method
        label Payment Method *
        .payment-methods
          .method-option#mpesa-option.active
            input#method-mpesa(type="radio" name="paymentMethod" value="mpesa" checked)
            .method-card
              i.fa-solid.fa-mobile-screen-button
              span M-Pesa
          .method-option#card-option
            input#method-card(type="radio" name="paymentMethod" value="card")
            .method-card
              i.fa-solid.fa-credit-card
              span Card

        //- Phone (shown for M-Pesa only)
        #phone-field
          label(for="phone") M-Pesa Phone Number *
          input#phone(
            type="tel"
            name="phone"
            placeholder="e.g. 0712345678"
          )

        //- Amount Presets
        label(for="amount") Enter Amount (KES) *
        .amount-btns
          button.amount-btn(type="button" data-amount="200") KES 200
          button.amount-btn(type="button" data-amount="500") KES 500
          button.amount-btn(type="button" data-amount="1000") KES 1,000
          button.amount-btn(type="button" data-amount="2000") KES 2,000
        input#amount(type="number" name="amount" placeholder="Or enter amount (KES)" required)

        //- Pay Button
        button#payBtn.payBtn(type="button")
          i.fa-solid.fa-mobile-screen-button
          |  Pay with M-Pesa

    script(src="/js/payment.js")