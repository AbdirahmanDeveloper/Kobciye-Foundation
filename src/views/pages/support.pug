include ../layout/_head

body
  include ../partials/_navbar

  block content

    //- HERO SECTION
    section.hero.support-hero
      .hero-content
        .hero-txt(data-aos="fade-up" data-aos-duration="800")
          h1 Need a Support
          p Reach us filing the below form to consider your request.

    //- SUPPORT FORM SECTION
    section.support-section
      .section-divider(data-aos="fade-up")
        .divider-label Join As a Volunteer

      .support-container(data-aos="fade-up" data-aos-duration="600")
        form.support-form#supportForm(enctype="multipart/form-data")

          .form-row
            .form-group
              label Full Name
              input(type="text" name="name" placeholder="Enter your full name" required)
            .form-group
              label Email Address
              input(type="email" name="email" placeholder="Enter your email" required)

          .form-row
            .form-group
              label Phone Number
              input(type="tel" name="phone" placeholder="e.g. +254 700 000 000" required)
            .form-group
              label Location
              input(type="text" name="location" placeholder="Your city or town" required)

          .form-row
            .form-group
              label National ID
              input(type="text" name="nationalId" placeholder="Enter your national ID number" required)
            .form-group
              label Upload National ID
              input(type="file" name="nationalIdDoc" required)
            .form-group
              label Support Documents if Applicable
              input(type="file" name="supportDocuments" multiple required)

            .form-group
              label Photo
              input(type="file" name="image" accept="image/*" required)
            
            .form-group
              label Support Subject
              input(type="text" name="subject" placeholder="Enter the subject" required)

          .form-group
            label Message
            textarea(name="message" rows="5" placeholder="Tell us about yourself and how you'd like to help..." required)

          button.support-submit-btn(type="submit")
            i.fa-solid.fa-paper-plane
            |  Submit

        .success-message#supportSuccess(style="display:none")
          i.fa-solid.fa-circle-check
          h2 Application Submitted!
          p Thank you for reaching out. We will get back to you shortly.

        .error-message#supportError(style="display:none")
          i.fa-solid.fa-circle-xmark
          h2 Submission Failed
          p Something went wrong. Please try again.

  include ../partials/_footer

  script(src="/js/support.js")
  script(src="/js/main.js")