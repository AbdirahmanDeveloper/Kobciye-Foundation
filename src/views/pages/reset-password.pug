doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css")
    title Reset Password || Kobciye Foundation
    link(rel="stylesheet" href="/css/auth.css")
  body

    form.form#reset-form
      h1 New Password
      p Enter and confirm your new password

      .input-box
        label New Password
        .pass-error-message(style="color:red; font-weight:bold; display:none;")
        .input-with-icon
          i.fa-solid.fa-lock
          input#newPassword(type="password" placeholder="Min. 8 characters")
          i.fa-solid.fa-eye.toggle-password#togglePassword(style="left:auto; right:14px; cursor:pointer; pointer-events:all;")


      .input-box
        label Confirm Password
        .pass-confirm-error-message(style="color:red; font-weight:bold; display:none;")
        .input-with-icon
          i.fa-solid.fa-lock
          input#confirmPassword(type="password" placeholder="Repeat password")
          i.fa-solid.fa-eye.toggle-password#toggleConfirmPassword(style="left:auto; right:14px; cursor:pointer; pointer-events:all;")

      .error-msg#resetError
      button.auth-btn(type="submit") Update Password

    script(src="/js/reset-password.js")