include ../layout/_head

body
  include ../partials/_navbar

  block content
    //- BLOG HERO
    section.hero.blog-hero
      .hero-content.blog-hero-content
        .hero-txt(data-aos="fade-up" data-aos-duration="800")
          h1 Latest Blog Posts
          p Stories, updates, and insights from Kobciye Foundation

    //- BLOG SECTION
    section.blog-section
      .section-divider(data-aos="fade-up")
        .divider-label Explore Our News
      .blog-container
        each item, index in news
          article.blog-card(
            data-aos="fade-up"
            data-aos-delay=`${index * 100}`
            data-aos-duration="600"
          )
            .blog-card-img
              img(src=item.image ? `/uploads/news/${item.image}` : "/images/blog-hero.png" alt=item.title)
            .blog-card-body
              h2.blog-card-title= item.title
              p.blog-card-text= item.content ? item.content.substring(0, 120) + '...' : ''
              .blog-card-btn-time
                a.blog-card-btn(href=`/blog/${item._id}`)
                  span Read More
                  i.fa-solid.fa-arrow-right
                .blog-card-meta
                  i.fa-regular.fa-calendar
                  time= item.createdAt ? item.createdAt.toDateString() : ''

    //- TESTIMONIALS
    section.testimonials
      .section-divider(data-aos="fade-up")
        .divider-line
        .divider-label What People Said About Us
        .divider-line
      .testimonial-cards
        .testimonial-card(data-aos="fade-up" data-aos-delay="0" data-aos-duration="600")
          .quote-icon "
          p "Kobciye helped my community get clean water. Truly life-changing!"
          h3 — Amina, Nairobi
        .testimonial-card(data-aos="fade-up" data-aos-delay="200" data-aos-duration="600")
          .quote-icon "
          p "Volunteering here taught me the value of giving back."
          h3 — John, Volunteer

    //- IMPACTS
    .section-divider(data-aos="fade-up")
      .divider-label Our Impact
    section.impact-stats
      .stat(data-aos="fade-up" data-aos-delay="0" data-aos-duration="600")
        .stat-icon
          i.fa-solid.fa-people-group
        h2 200+
        p Communities Served
      .stat(data-aos="fade-up" data-aos-delay="150" data-aos-duration="600")
        .stat-icon
          i.fa-solid.fa-circle-check
        h2 50+
        p Projects Completed
      .stat(data-aos="fade-up" data-aos-delay="300" data-aos-duration="600")
        .stat-icon
          i.fa-solid.fa-hands-holding-child
        h2 500+
        p Volunteers Engaged

    //- CALL ON ACTION
    section.get-involved(data-aos="fade-up" data-aos-duration="700")
      h1 Get Involved
      p Join us in making a real difference in people's lives. Your support matters.
      a.get-involved-btn(href="/payment") Get Involved

  include ../partials/_footer

  script(src="/js/main.js")