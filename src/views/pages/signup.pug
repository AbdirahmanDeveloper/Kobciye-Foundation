doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css")
    title Signup || Kobciye Foundation
    link(rel="stylesheet" href="/css/auth.css")
  body
    form.form#signup-form
      h1 Create Account
      p Join Kobciye Foundation today
      .signup-error-message(style="color:red; font-weight:bold; display:none;")

      .input-box
        label(for="name") Full Name
        .input-with-icon
          i.fa-solid.fa-user
          input(type="text" id="name" name="name" placeholder="Joe Doe" required)


      .input-box
        label(for="email") Email
        .input-with-icon
          i.fa-solid.fa-envelope
          input(type="email" id="email" name="email" placeholder="JoeDoe@gmail.com" required)

      .input-box
        label(for="phone") Phone Number
        .input-with-icon
          i.fa-solid.fa-phone
          input(type="tel" id="phone" name="phone" placeholder="e.g. +254712345678" required)

      .input-box
        label(for="country") Country
        .input-with-icon
          i.fa-solid.fa-globe
          select#country(name="country" required)
            option(value="" disabled selected) Select your country

      .input-box
        p
        label(for="password") Password
        .pass-error-message(style="color:red; font-weight:bold; display:none;")
        .input-with-icon
          i.fa-solid.fa-lock
          input(type="password" id="password" name="password" placeholder="Min. 8 characters" required)
          i.fa-solid.fa-eye.toggle-password#togglePassword(style="left:auto; right:14px; cursor:pointer; pointer-events:all;")


      .input-box
        label(for="confirm-password") Confirm Passwordp
        .pass-confirm-error-message(style="color:red; font-weight:bold; display:none;")
        .input-with-icon
          i.fa-solid.fa-lock
          input(type="password" id="confirm-password" placeholder="Confirm Your Password" required)
          i.fa-solid.fa-eye.toggle-password#toggleConfirmPassword(style="left:auto; right:14px; cursor:pointer; pointer-events:all;")


      button.auth-btn(type="submit") Sign Up

      p.switch
        | Already have an account? 
        a(href="/login") Login

  script(src="/js/signup.js")

    