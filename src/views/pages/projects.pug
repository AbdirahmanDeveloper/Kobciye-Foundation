include ../layout/_head

body
  include ../partials/_navbar

  block content

    section.hero.projects-hero
      .hero-content.projects-hero-content
        .hero-txt(data-aos="fade-up" data-aos-duration="800")
          h1 Our Projects
          h3 See how we are transforming lives through impactful initiatives

    section.projects-section
      .section-header(data-aos="fade-up")
        span.section-eyebrow Our Work

      .section-divider(data-aos="fade-up")
        .divider-line
        .divider-label Ongoing Missions
        .divider-line

      .projects-container
        if ongoingProjects && ongoingProjects.length > 0
          each project, index in ongoingProjects
            .project-card(
              data-aos="fade-up"
              data-aos-delay=`${index * 100}`
              data-aos-duration="600"
            )
              .project-img
                img(src=project.image)
                .card-badge.active Active
              .card-content
                h2.project-title= project.title
                .project-desc-wrapper
                  p.project-desc= project.description
                  i.fa-solid.fa-chevron-down
                .progress-wrapper
                  .progress-bar-container
                    .progress-bar(style=`width: ${project.progressPercentage}%`)
                  .goal-raised
                    p.goal-amount 🎯 KSh #{project.goalAmount.toLocaleString()}
                    p.raised-amount 💰 KSh #{project.raisedAmount.toLocaleString()}
                  p.progress-percentage= `${project.progressPercentage}% Funded`
                .card-actions
                  a.view-btn(href=`/projects/${project._id}`)
                    i.fa-solid.fa-eye
                    |  View Project
                  a.donate-btn(href=`/payment?project=${project._id}`) Donate Now →
        else
          .empty-state(data-aos="fade-up")
            i.fa-solid.fa-folder-open
            p No active projects at the moment.
            a.get-involved-btn(href="/contact") Contact Us

      .section-divider(data-aos="fade-up")
        .divider-line
        .divider-label Completed Missions
        .divider-line

      .projects-container
        if completedProjects && completedProjects.length > 0
          each project, index in completedProjects
            .project-card.completed(
              data-aos="fade-up"
              data-aos-delay=`${index * 100}`
              data-aos-duration="600"
            )
              .project-img
                img(src=project.image)
                .card-badge.done ✓ Funded
              .card-content
                h2.project-title= project.title
                .project-desc-wrapper
                  p.project-desc= project.description
                .progress-wrapper
                  .progress-bar-container
                    .progress-bar(style=`width: ${project.progressPercentage}%`)
                  .goal-raised
                    p.goal-amount 🎯 KSh #{project.goalAmount.toLocaleString()}
                    p.raised-amount 💰 KSh #{project.raisedAmount.toLocaleString()}
                  p.progress-percentage= `${project.progressPercentage}% Funded`
                .card-actions
                  a.view-btn(href=`/projects/${project._id}`)
                    i.fa-solid.fa-eye
                    |  View Project
                  button.donate-btn.completed-btn(disabled) ✓ Goal Reached
        else
          .empty-state(data-aos="fade-up")
            i.fa-solid.fa-circle-check
            p No completed projects yet.
            a.get-involved-btn(href="/contact") Contact Us

  include ../partials/testimonials

  include ../partials/_footer

  script(src="/js/main.js")
  script(src="/js/project.js")