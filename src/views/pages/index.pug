include ../layout/_head

body
  include ../partials/_navbar
    
  block content
    //- HERO SECTION
    section.hero.home-hero
      .hero-content.home-hero-content
        .hero-txt(data-aos="fade-up" data-aos-duration="800")
          h1 Welcome To Kobciye Foundation
          p Where Humanity Exists

    //- PROJECTS SECTION
    section.home-projects-section
      .section-divider(data-aos="fade-up")
        .divider-line
        .divider-label Ongoing Missions
        .divider-line
      
      .projects-wrapper
        button.project-scroll-btn.ps-left
          i.fa-solid.fa-chevron-left
        if ongoingProjects && ongoingProjects.length > 0
          .home-projects-container
            each project, index in ongoingProjects
              a.home-project-card(
                href="/projects"
                data-aos="fade-up"
                data-aos-delay=`${index * 100}`
                data-aos-duration="600"
              )
                .home-project-img
                  img(src=project.image alt=project.title)
                .home-card-overlay
                  .home-card-top
                    span.home-card-badge Active
                  .home-card-bottom
                    h2.home-project-title= project.title
                    .home-card-progress
                      .home-card-progress-bar
                        .home-card-progress-fill(style=`width: ${Math.min(Math.round((project.raisedAmount / project.goalAmount) * 100), 100)}%`)
                      .home-card-amounts
                        span KSh #{project.raisedAmount ? project.raisedAmount.toLocaleString() : '0'} raised
                        span #{Math.min(Math.round((project.raisedAmount / project.goalAmount) * 100), 100)}%
                    span.home-donate-cta
                      | Support This →
        else
          .empty-state(data-aos="fade-up")
            i.fa-solid.fa-folder-open
            p No active projects at the moment
            a.get-involved-btn(href="/contact") Contact Us
        button.project-scroll-btn.ps-right
          i.fa-solid.fa-chevron-right

    //- TEAM SECTION
    section.team
      .section-divider(data-aos="fade-up")
        .divider-line
        .divider-label Meet Our Team
        .divider-line

      .team-wrapper
        button.scroll-btn.left
          i.fa-solid.fa-chevron-left

        .team-container
          if members && members.length > 0
            each member, index in members
              .team-card(
                data-aos="fade-up"
                data-aos-delay=`${index * 100}`
                data-aos-duration="500"
              )
                .team-card-img
                  img(src=member.memberImage alt=member.name)
                .team-card-info
                  h3.team-name= member.name
                  p.team-role= member.role
          else
            p.empty-state No team members found.

        button.scroll-btn.right
          i.fa-solid.fa-chevron-right

    //- LATEST NEWS SECTION
    section.home-news-section
      .section-divider(data-aos="fade-up")
        .divider-line
        .divider-label Latest News
        .divider-line

      if latestNews && latestNews.length > 0
        .home-news-grid
          each article, index in latestNews
            article.home-news-card(
              class=index === 0 ? 'featured' : ''
              data-aos="fade-up"
              data-aos-delay=`${index * 120}`
              data-aos-duration="600"
            )
              .home-news-img-wrapper
                img.home-news-img(
                  src=article.image
                  alt=article.title
                )
                span.home-news-tag News
              .home-news-body
                .home-news-meta
                  i.fa-solid.fa-calendar-days
                  time= article.createdAt ? new Date(article.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : ''
                h3.home-news-title= article.title
                p.home-news-excerpt= article.content ? article.content.substring(0, index === 0 ? 180 : 100) + '...' : ''
                a.home-news-readmore(href=`/blog/${article._id}`)
                  span Read More
                  i.fa-solid.fa-arrow-right
      else
        .empty-state(data-aos="fade-up")
          i.fa-solid.fa-newspaper
          p No news articles yet
          a.get-involved-btn(href="/blog") Visit Blog

      .home-news-footer(data-aos="fade-up" data-aos-delay="200")
        a.view-all-news-btn(href="/blog")
          i.fa-solid.fa-newspaper
          span View All News

      //- VOLUNTEER FORM SECTION
    section.volonteer-section
      .volonteer-form
        .section-title
          span.eyebrow Kobciye Foundation
          h1 Apply Now
          p Fill in the form below and we'll get back to you shortly.

        form#volonteerForm.contact-form(enctype="multipart/form-data")

          .input-box
            label(for="volName")
              | Your Full Name
              span.req *
            input(type="text" name="volName" id="volName" placeholder="Joe Doe" required)

          .input-box
            label(for="volPhone")
              | Your Phone Number
              span.req *
            input(type="tel" name="volPhone" id="volPhone" placeholder="+254 700 000 000" required)

          .input-box
            label(for="volEmail")
              | Your Email
              span.req *
            input(type="email" name="volEmail" id="volEmail" placeholder="joeDoe@gmail.com" required)

          .input-box
            label(for="volImage")
              | Passport Photo
            input(type="file" name="volImage" id="volImage" accept="image/png, image/jpeg" required)
            span.field-error#imageError(style="display:none; color:red; font-size:0.8rem;")

          .input-box
            label(for="availibility")
              | Your Availability
              span.req *
            input(id="availibility" name="availibility" placeholder="e.g: 7 Days a Week" required)

          .input-box
            label(for="nationalId")
              | National ID Number / Birth Certificate
              span.req *
            input(id="nationalId" name="nationalId" placeholder="e.g: 000 000 000 0" required)

          .input-box
            label(for="nationalIdDoc")
              | Upload National ID / Birth Certificate
            input(id="nationalIdDoc" type="file" name="nationalIdDoc" accept="image/png, image/jpeg, application/pdf" required)
          .input-box
            label(for="bio")
              | Your Bio
            textarea(id="bio" name="bio" placeholder="Your Bio" required)

          .input-box
            label(for="address")
              | Your Address
              span.req *
            input(id="address" name="address" placeholder="e.g: Eastleigh 6th st" required)

          .form-divider

          //- VOLUNTEER TYPE
          .input-box
            label(for="volunteerType")
              | Volunteer Type
              span.req *
            select#volunteerType(name="type" required)
              option(value="") Select type...
              option(value="permanent") Permanent Volunteer
              option(value="mission") Mission Volunteer
              option(value="project") Project Volunteer

          //- MISSION SELECT
          .input-box#missionsBox(style="display:none")
            label(for="missionSelect")
              | Select Mission
              span.req *
            select#missionSelect(name="missionId")
              option(value="") Select a mission...
              if missions && missions.length > 0
                each mission in missions
                  option(value=mission._id)= mission.title
              else
                option(value="" disabled) No active missions available

          .input-box#projectsBox(style="display:none")
            label(for="projectSelect")
              | Select Project
              span.req *
            select#projectSelect(name="projectId")
              option(value="") Select a project...
              if ongoingProjects && ongoingProjects.length > 0
                each project in ongoingProjects
                  option(value=project._id)= project.title
              else
                option(value="" disabled) No active projects available

          .form-divider
          button.vol-submit(type="submit") Submit Application
          p.privacy-note We respect your privacy. Your information will only be used to contact you about volunteering opportunities.

        .message-modal#volMessageModal
          .message-content.success#contactSuccessMessage
            i.fa-solid.fa-circle-check
            h2 Application Submitted!
            p We've received your application and will get back to you soon.
            button.ok-btn OK
          .message-content.error#volErrorMessage
            i.fa-solid.fa-circle-xmark
            h2 Submission Failed
            p Something went wrong. Please try again.
            button.ok-btn OK

    include ../partials/testimonials
    include ../partials/_footer

  script(src="/js/main.js")
  script(src="/js/about.js")