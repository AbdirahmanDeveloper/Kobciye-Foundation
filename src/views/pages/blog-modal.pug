doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{news.title} || Kobciye Foundation
    link(rel="stylesheet" href="/css/index.css")
    link(rel="stylesheet" href="/css/blog.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")

  body
    block content
      section.blog-modal-section
        a.back-btn(href="/blog")
          i.fa-solid.fa-arrow-left
          |  Back to News

        article.blog-modal
          .blog-modal-img
            img(src=news.image alt=news.title)
            .blog-modal-overlay
              span.blog-modal-category News

          .blog-modal-txt
            .blog-modal-meta
              i.fa-regular.fa-calendar
              span= news.createdAt.toDateString()
            h1.blog-modal-title= news.title
            p.blog-modal-script= news.content
  include ../partials/testimonials
