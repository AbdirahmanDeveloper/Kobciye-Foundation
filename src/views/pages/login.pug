doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Login || Kobciye Foundation
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css")
    link(rel="stylesheet" href="/css/auth.css")

  body
    form.form#login-form
      h1 Welcome Back
      p Please login to your account

      .input-box
        label(for="email") Email
        .input-with-icon
          i.fa-solid.fa-envelope
          input(type="email" id="email" placeholder="Enter your email")

      .input-box
        label(for="password") Password
        .input-with-icon
          i.fa-solid.fa-lock
          input(type="password" id="password" placeholder="Enter your password")
          i.fa-solid.fa-eye.toggle-password#togglePassword(style="left:auto; right:14px; cursor:pointer; pointer-events:all;")
        a.forgot-link#forgotBtn(href="#") Forgot password?

      .error-msg#errorMsg

      button.auth-btn(type="submit") Login

      p.switch
        | Don't have an account?
        a(href="/signup")  Sign Up

    script(src="/js/login.js")